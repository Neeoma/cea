# CEA platform — environment
# Copy to .env.local and fill in. Never commit real values.
# All of these are SERVER-side only. Nothing here may be prefixed NEXT_PUBLIC_
# unless it is genuinely safe to expose in the browser.

# --- Site -------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.cea.ng

# --- Database (Supabase / PostgreSQL) ---------------------------------------
# Service-role key bypasses row-level security. Server only. Never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# --- Payments (Paystack) ----------------------------------------------------
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=          # server only — used for webhook signature checks
PAYSTACK_WEBHOOK_SECRET=

# --- Email (Resend) ---------------------------------------------------------
RESEND_API_KEY=
ADMISSIONS_FROM_EMAIL=admissions@cea.ng

# --- Analytics (optional, consent-gated) ------------------------------------
NEXT_PUBLIC_GA4_ID=
POSTHOG_API_KEY=

# --- Rate limiting ----------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
